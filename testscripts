		// int totalcol = dc.columncount(0);

		Object[][] data = new Object[totalrow][2];

		for (int i = 0; i < totalrow; i++) {
			// for(int j=0;j<totalcol;j++){
			data[i][0] = dc.getdata(0, i, 0);
			data[i][1] = dc.getdata(0, i, 1);
			
		}
		return data;
